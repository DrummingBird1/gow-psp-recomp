# --- Game data, and anything that contains the game's code: never commit ---
*.chd
*.iso
*.cso
*.pbp
re/dumps/
re/out/recomp/*.bin
re/out/*.vfpu.tsv
build/

# Ghidra project (holds the complete analyzed programs)
re/ghidra/

# Third-party reference sources (PPSSPP, GPL); fetch again with the commands in README.md
re/ppsspp-hle/
re/ppsspp-mips/
re/ppsspp-gpu/

# Progress screenshots and gameplay recordings (they show the game's imagery)
media/

# Tooling
.venv/
__pycache__/
*.pyc

# Analysis logs
re/out/*.log
re/out/*.console.txt
